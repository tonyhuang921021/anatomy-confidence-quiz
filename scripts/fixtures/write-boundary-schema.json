      },
      {
        "name": "figure_pdm_manual_evidence_check",
        "definition": "CHECK (((license <> 'PDM 1.0'::text) OR (((pdm_image_url ~* '^https://upload[.]wikimedia[.]org/wikipedia/commons/[0-9a-f]/[0-9a-f]{2}/[^/?#]+[.](png|jpe?g|webp)$'::text) AND (pdm_evidence_by IS NOT NULL) AND (pdm_evidence_at IS NOT NULL) AND (\"substring\"(source_url, '[^/]+$'::text) = ('File:'::text || \"substring\"(pdm_image_url, '[^/]+$'::text)))) IS TRUE)))"
