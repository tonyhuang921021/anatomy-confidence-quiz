    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "next lint",
    "test:mastery": "tsc --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --strict --outDir /private/tmp/anatomy-mastery-tests lib/masteryAnalysis.ts lib/masteryAnalysis.test.ts && node --test /private/tmp/anatomy-mastery-tests/lib/masteryAnalysis.test.js",
    "test:primary-tags": "node scripts/primary-tag-display-map.test.js",
    "test:quiz-analysis": "tsc -p tsconfig.quiz-analysis-test.json && node --test /private/tmp/anatomy-quiz-analysis-tests/lib/questionTextFormat.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/analysisPrimaryTag.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/questionTrackFilters.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/weaknessAnalysis.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/currentSessionSelection.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/cloudHistorySync.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/feedbackAuth.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/cloudSyncWriteGuard.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/quizSessionSyncSafety.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/progressMetrics.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/quizAnalysis.selection.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/relatedQuestions.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/savedQuestionReview.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/startSettingsUrl.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/storage.completed-history.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
