{
  "name": "anatomy-confidence-quiz",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "next lint",
    "sync:laozhao": "node --env-file=.env.local scripts/laozhao/sync-youtube-playlist.mjs",
    "check:laozhao-manifest": "node scripts/laozhao/check-manifest-freshness.mjs",
    "check:laozhao-tools": "node --env-file=.env.local scripts/laozhao/run-python-tool.mjs check",
    "transcribe:laozhao": "node --env-file=.env.local scripts/laozhao/run-python-tool.mjs transcribe",
    "package:laozhao-transcript": "node scripts/laozhao/build-transcript-review-package.mjs",
    "validate:laozhao-chapters": "node scripts/laozhao/validate-chapter-draft.mjs",
    "extract:laozhao-board": "node --env-file=.env.local scripts/laozhao/run-python-tool.mjs board",
    "test:mastery": "tsc --target ES2022 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --strict --outDir /private/tmp/anatomy-mastery-tests lib/masteryAnalysis.ts lib/masteryAnalysis.test.ts && node --test /private/tmp/anatomy-mastery-tests/lib/masteryAnalysis.test.js",
    "test:primary-tags": "node scripts/primary-tag-display-map.test.js",
    "test:laozhao": "tsc -p tsconfig.laozhao-test.json && node --test /private/tmp/anatomy-laozhao-tests/lib/laozhao/content/importer.test.js /private/tmp/anatomy-laozhao-tests/lib/laozhao/content/importerNode.test.js /private/tmp/anatomy-laozhao-tests/lib/laozhao/content/repository.test.js /private/tmp/anatomy-laozhao-tests/lib/laozhao/content/validator.test.js /private/tmp/anatomy-laozhao-tests/lib/laozhao/local/localData.test.js && node --test scripts/laozhao/sync-youtube-playlist.test.mjs scripts/laozhao/review-package-core.test.mjs && PYTHONPYCACHEPREFIX=/private/tmp/anatomy-laozhao-pycache python3 -m py_compile scripts/laozhao/transcribe-authorized-source.py scripts/laozhao/extract-board-candidates.py",
    "test:laozhao:e2e": "playwright test --config=playwright.laozhao.config.ts",
    "test:quiz-analysis": "tsc -p tsconfig.quiz-analysis-test.json && node --test /private/tmp/anatomy-quiz-analysis-tests/lib/questionTextFormat.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/analysisPrimaryTag.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/questionTrackFilters.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/weaknessAnalysis.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/currentSessionSelection.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/quizSessionNavigation.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/cloudHistorySync.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/feedbackAuth.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/cloudSyncWriteGuard.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/customPaperSearch.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/quizSessionSyncSafety.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/quizSessionCheckpoint.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/progressMetrics.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/questionSearch.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/quizAnalysis.selection.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/relatedQuestions.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/aiSimulationPaperV2.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/simulationPaperStats.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/postExamReflection.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/resumableSessions.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/resultReviewNavigation.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/savedQuestionReview.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/savedQuestionBank.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/startSettingsUrl.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/storage.completed-history.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/reviewYearFilter.test.js /private/tmp/anatomy-quiz-analysis-tests/lib/reviewQuestionOrder.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^1.28.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "22.15.21",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
